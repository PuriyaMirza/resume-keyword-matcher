{
  "status": "draft",
  "note": "DRAFT for review. Not verified. Seeded by Claude; edit freely. See reviewNotes for terms flagged as uncertain.",
  "reviewNotes": {
    "product-management": "\"PM\" can also mean project manager or program manager.",
    "customer-centric": "Soft-skill phrase; common in JDs but vague.",
    "communication-skills": "Soft skill. Bare \"communication\" left out on purpose (too common).",
    "decision-making": "Soft skill; may appear in almost any JD.",
    "executive-communication": "\"executive stakeholders\" may overlap with stakeholder-management in meaning.",
    "dependency-management": "Bare \"dependencies\" can be a software term.",
    "scaled-agile": "Bare \"SAFe\" left out because it would match the word \"safe\".",
    "sprint-planning": "Bare \"sprint\" may match \"sprint\" used loosely.",
    "backlog-management": "Bare \"backlog\" can mean an order backlog in ops roles.",
    "amplitude": "Also a physics/audio word.",
    "spreadsheets": "Bare \"Excel\" left out because \"excel at\" would match.",
    "engagement": "Bare \"engagement\" also means employee or client engagement.",
    "retention": "Could mean data retention or employee retention.",
    "machine-learning": "\"ML\" only matches in capitals, so lowercase \"ml\" (millilitres) is ignored.",
    "api": "Bare \"REST\" left out because \"the rest of\" would match.",
    "technical-background": "\"computer science\" may be an education requirement, not a skill.",
    "crm": "Salesforce/HubSpot are tools, grouped under CRM for simplicity.",
    "compliance": "Bare \"compliance\" is broad.",
    "javascript": "\"JS\" is case-insensitive.",
    "conversion-rate": "Bare \"conversion\" is broad."
  },
